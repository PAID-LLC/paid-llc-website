# PAID LLC website — environment variables
#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Production values live in the Cloudflare Pages dashboard, not here.
#
# Generated 2026-08-19 by grepping every process.env.* reference in
# app/, lib/, scripts/ and components/. Before this file existed, the only
# record of what this site needs was one uncommitted file on one machine,
# which meant nobody could redeploy from a clean checkout, including its owner.
#
# Regenerate the name list with:
#   grep -rhoE 'process\.env\.[A-Z_][A-Z0-9_]*' app lib scripts components \
#     | sed 's/process\.env\.//' | sort -u

# ── Required: the site will not function without these ───────────────────────

# Supabase. Service key only — the app is 100% service-key and every table is
# deny-all RLS. URL must be https:// (lib/supabase.ts throws otherwise).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gemini. BILLED, not free — see the cost-cap note in lib/usage-guard.ts.
GEMINI_API_KEY=

# ── Payments: needed for any revenue path ────────────────────────────────────

# Stripe. Webhook secret is required for signature verification in
# app/api/stripe-webhook — without it the webhook cannot be trusted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUPPORT_LINK=
STRIPE_SUPPORT_PRODUCT_ID=

# Coinbase (Commerce + CDP rails)
COINBASE_COMMERCE_API_KEY=
COINBASE_CDP_KEY_ID=
COINBASE_CDP_PRIVATE_KEY=
COINBASE_WEBHOOK_SECRET=

# x402 USDC settlement address
X402_PAY_TO_ADDRESS=

# ── Delivery and email ───────────────────────────────────────────────────────

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Written but not yet wired — see the pending bounce-webhook work.
RESEND_WEBHOOK_SECRET=

MAILERLITE_API_KEY=
MAILERLITE_LEAD_GROUP_ID=

# ── Auth and scheduled jobs ──────────────────────────────────────────────────

# CRON_SECRET gates every /api/**/tick and pulse route. The Executive Assistant
# repo needs the SAME value in its own .env; that copy step being skipped cost
# five consecutive failed Revenue Officer runs.
CRON_SECRET=

# Signs agent JWTs (lib/jwt). Rotating this invalidates every issued agent token.
JWT_SECRET=

ADMIN_SECRET=
ADMIN_EMAIL=

# ── Voice: Ask Arti TTS ──────────────────────────────────────────────────────

# Cloudflare Workers AI is the working path. Setting these two is the fix for
# the /api/tts 503; the ElevenLabs branch below is then never reached.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# ElevenLabs. Currently returns ivc_not_permitted for the configured voice
# because the plan refuses instantly-cloned voices. Stock voice that works:
# 21m00Tcm4TlvDq8ikWAM
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Optional / integration-specific ──────────────────────────────────────────

BRAVE_SEARCH_API_KEY=
OPENAI_API_KEY=
MY3SONS_ACCESS_TOKEN=
PAIDDEV_ACCESS_TOKEN=
PAIDDEV_WEBHOOK_SECRET=
STOREFRONT_ORIGIN=

# ── Public (exposed to the browser — never put a secret in a NEXT_PUBLIC_ var) ─

NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CALENDAR_URL=
NEXT_PUBLIC_GA_ID=

# Set automatically at build time by scripts/build-cf.mjs. Do not set by hand.
# NEXT_PUBLIC_BUILD_SHA
# NEXT_PUBLIC_BUILD_STAMP
# CF_PAGES_COMMIT_SHA
